{
  "$defs": {
    "AuditConfig": {
      "additionalProperties": false,
      "properties": {
        "redact_secret_values": {
          "default": true,
          "title": "Redact Secret Values",
          "type": "boolean"
        },
        "redact_paths": {
          "default": true,
          "title": "Redact Paths",
          "type": "boolean"
        },
        "redact_endpoints": {
          "default": true,
          "title": "Redact Endpoints",
          "type": "boolean"
        },
        "transcript_retention_days": {
          "default": 0,
          "minimum": 0,
          "title": "Transcript Retention Days",
          "type": "integer"
        }
      },
      "title": "AuditConfig",
      "type": "object"
    },
    "CliChannel": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "CliChannel",
      "type": "object"
    },
    "DefaultsConfig": {
      "additionalProperties": false,
      "description": "Frozen security defaults (public config).",
      "properties": {
        "listen": {
          "default": "127.0.0.1",
          "title": "Listen",
          "type": "string"
        },
        "public_bind": {
          "default": false,
          "title": "Public Bind",
          "type": "boolean"
        },
        "public_bind_risk_acknowledged": {
          "default": false,
          "title": "Public Bind Risk Acknowledged",
          "type": "boolean"
        },
        "dm_only": {
          "default": true,
          "title": "Dm Only",
          "type": "boolean"
        },
        "group_execution": {
          "default": false,
          "title": "Group Execution",
          "type": "boolean"
        },
        "group_execution_risk_acknowledged": {
          "default": false,
          "title": "Group Execution Risk Acknowledged",
          "type": "boolean"
        },
        "owner_allowlist_required": {
          "default": true,
          "title": "Owner Allowlist Required",
          "type": "boolean"
        },
        "high_risk_confirmation": {
          "default": true,
          "title": "High Risk Confirmation",
          "type": "boolean"
        },
        "raw_audio_storage": {
          "default": false,
          "title": "Raw Audio Storage",
          "type": "boolean"
        },
        "temp_audio_delete": {
          "default": true,
          "title": "Temp Audio Delete",
          "type": "boolean"
        },
        "cloud_asr": {
          "default": "opt_in_only",
          "enum": [
            "opt_in_only",
            "disabled"
          ],
          "title": "Cloud Asr",
          "type": "string"
        },
        "remote_execution": {
          "default": false,
          "title": "Remote Execution",
          "type": "boolean"
        }
      },
      "title": "DefaultsConfig",
      "type": "object"
    },
    "GroupExecutionConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "risk_acknowledged": {
          "default": false,
          "title": "Risk Acknowledged",
          "type": "boolean"
        }
      },
      "title": "GroupExecutionConfig",
      "type": "object"
    },
    "LocalWebChannel": {
      "additionalProperties": false,
      "properties": {
        "listen": {
          "default": "127.0.0.1",
          "title": "Listen",
          "type": "string"
        },
        "port": {
          "default": 8080,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "public_bind": {
          "default": false,
          "title": "Public Bind",
          "type": "boolean"
        },
        "public_bind_risk_acknowledged": {
          "default": false,
          "title": "Public Bind Risk Acknowledged",
          "type": "boolean"
        }
      },
      "title": "LocalWebChannel",
      "type": "object"
    },
    "PrivateChannels": {
      "additionalProperties": false,
      "properties": {
        "local_web": {
          "$ref": "#/$defs/LocalWebChannel"
        },
        "cli": {
          "$ref": "#/$defs/CliChannel"
        }
      },
      "title": "PrivateChannels",
      "type": "object"
    },
    "PrivateSpeech": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "asr_backend": {
          "default": "disabled",
          "enum": [
            "local_faster_whisper",
            "cloud_opt_in",
            "disabled"
          ],
          "title": "Asr Backend",
          "type": "string"
        },
        "raw_audio_storage": {
          "default": false,
          "title": "Raw Audio Storage",
          "type": "boolean"
        },
        "temp_audio_delete": {
          "default": true,
          "title": "Temp Audio Delete",
          "type": "boolean"
        },
        "transcript_retention_days": {
          "default": 0,
          "minimum": 0,
          "title": "Transcript Retention Days",
          "type": "integer"
        },
        "cloud_asr_opt_in": {
          "default": false,
          "title": "Cloud Asr Opt In",
          "type": "boolean"
        }
      },
      "title": "PrivateSpeech",
      "type": "object"
    },
    "PrivateState": {
      "additionalProperties": false,
      "properties": {
        "sqlite_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sqlite Path"
        },
        "model_cache_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Cache Path"
        }
      },
      "title": "PrivateState",
      "type": "object"
    },
    "SecretRefDecl": {
      "additionalProperties": false,
      "description": "A SecretRef *declaration* (never a value).",
      "properties": {
        "backend": {
          "enum": [
            "env",
            "oskeyring",
            "dpapi",
            "file",
            "external_manager",
            "prompt_once"
          ],
          "title": "Backend",
          "type": "string"
        },
        "ref": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Ref",
          "type": "object"
        }
      },
      "required": [
        "backend"
      ],
      "title": "SecretRefDecl",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Merged effective runtime configuration after precedence resolution.",
  "properties": {
    "schema": {
      "const": "https://paios.ce/schemas/runtime-config/v0.1.json",
      "default": "https://paios.ce/schemas/runtime-config/v0.1.json",
      "title": "Schema",
      "type": "string"
    },
    "profile": {
      "default": "minimal",
      "enum": [
        "minimal",
        "standard",
        "full",
        "custom"
      ],
      "title": "Profile",
      "type": "string"
    },
    "runtime_profile": {
      "default": "lite",
      "enum": [
        "lite",
        "standard",
        "distributed_optional"
      ],
      "title": "Runtime Profile",
      "type": "string"
    },
    "defaults": {
      "$ref": "#/$defs/DefaultsConfig"
    },
    "owner_allowlist": {
      "items": {
        "type": "string"
      },
      "title": "Owner Allowlist",
      "type": "array"
    },
    "primary_provider": {
      "default": "mock",
      "title": "Primary Provider",
      "type": "string"
    },
    "fallback_provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Provider"
    },
    "provider_endpoint": {
      "default": "https://example.invalid/v1",
      "title": "Provider Endpoint",
      "type": "string"
    },
    "provider_credential_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SecretRefDecl"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "channels": {
      "$ref": "#/$defs/PrivateChannels"
    },
    "speech": {
      "$ref": "#/$defs/PrivateSpeech"
    },
    "state": {
      "$ref": "#/$defs/PrivateState"
    },
    "audit": {
      "$ref": "#/$defs/AuditConfig"
    },
    "group_execution": {
      "$ref": "#/$defs/GroupExecutionConfig"
    }
  },
  "title": "RuntimeConfig",
  "type": "object",
  "$id": "https://paios.ce/schemas/runtimeconfig/v0.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
